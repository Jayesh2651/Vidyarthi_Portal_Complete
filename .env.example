DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-this-with-a-secure-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
BACKEND_PUBLIC_URL=https://vidyarthi-portal-complete.vercel.app
FRONTEND_PUBLIC_URL=https://vidyarthi-portal-complete.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,vidyarthi-portal-complete.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vidyarthi-portal-complete.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vidyarthi-portal-complete.vercel.app
DJANGO_CROSS_SITE_COOKIES=False
BLOB_READ_WRITE_TOKEN=required-on-vercel-for-admin-file-uploads
VERCEL_BLOB_ACCESS=public
CORS_ALLOWED_ORIGIN_REGEXES=
AI_API_KEY=replace-with-your-chat-api-key
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_MODEL=llama-3.3-70b-versatile

# Optional dedicated embedding provider.
# If omitted, the assistant first tries the same provider as AI_API_KEY and
# then falls back to local hashed embeddings if embeddings are unavailable.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional extra study files/folders outside database-managed uploads.
AI_EXTRA_DOCUMENT_PATHS=

# Optional tuning
AI_VECTOR_STORE_DIR=.ai_store
AI_CHUNK_SIZE=900
AI_CHUNK_OVERLAP=180
AI_TOP_K=4
AI_CHAT_MAX_TOKENS=650
